# ============================================================
# Blockefy Backend — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` (see .gitignore).
# ============================================================

# Server
PORT=7980
NODE_ENV=development
BASE_URL=http://localhost:7980
FRONTEND_URL=http://localhost:5173

# CORS allowlist, comma-separated (no trailing slashes). When unset the server
# falls back to FRONTEND_URL / BASE_URL, and only if neither is configured does
# it reflect any origin (development-only behaviour).
# CORS_ORIGINS=http://localhost:5173,https://blockefy.vercel.app

# WALLET_ENC_KEY: at-rest encryption passphrase for custodial wallet private
# keys (AES-256-GCM). REQUIRED in production: without it keys are stored in
# plaintext. Generate with: openssl rand -base64 48
WALLET_ENC_KEY=

# --- Blockchain / escrow -----------------------------------------------------
# BNB Smart Chain Testnet (chainId 97). For local development use 31337 with a
# local node. RPC_URLS is a comma-separated failover list tried in order.
RPC_URL=https://bsc-testnet.drpc.org
# RPC_URLS=https://bsc-testnet.drpc.org,https://bsc-testnet-rpc.publicnode.com,https://data-seed-prebsc-1-s1.bnbchain.org:8545
CHAIN_ID=97
# Blockefy contract address (DEPLOYED). Overrides contracts/contractsData/Blockefy-address.json.
# The backend verifies the on-chain bytecode against the local artifact on every
# relay, so a stale address fails fast with CONTRACT_MISMATCH instead of reverting.
CONTRACT_ADDRESS=0x1247aB375f9C2451B681Cd3c13c42Fc518Eb5458
TX_CONFIRMATIONS=1
# Gas limit for relayed calls. Worst measured path is createMilestone with a
# 500-byte description (522,441 gas). Re-measure with `npm run measure:gas` if
# MAX_DESCRIPTION_LENGTH in the contract changes.
TX_GAS_LIMIT=900000

# Key of the ON-CHAIN CONTRACT OWNER (0x228d3654bd50C9D97931d43707181BBb6C46a7c3).
# Used for admin relays (openDispute, resolveDispute) and as a fallback for
# project creation. It MUST be the address that deployed the contract, otherwise
# admin calls are rejected. Leave unset only to skip admin functionality.
ADMIN_PRIVATE_KEY=0x...

# --- Live end-to-end test (npm run e2e:live) ----------------------------------
# Two DIFFERENT accounts, both funded with testnet BNB. Used only by
# scripts/e2e-live.js to exercise real escrow against the deployed contract.
# E2E_CLIENT_PRIVATE_KEY=0x...
# E2E_FREELANCER_PRIVATE_KEY=0x...
# Faucet: https://www.bnbchain.org/en/testnetFaucet

# When true, the scheduler releases escrow automatically for milestones whose
# review window lapsed (the contract permits this; someone must call claimMilestone).
# The contract still enforces the window, so this can never pay out early.
AUTO_RELEASE_ESCROW=false

# --- Database -----------------------------------------------------------------
# Local MongoDB is the active target. Start it with:
#   docker run -d --name blockefy-mongo -p 27017:27017 mongo:7
# (or `mongod --dbpath <data>` if MongoDB is installed natively)
#
# NOTE: with no database name in the URI, the driver silently falls back to a
# database called `test`. Always name it explicitly.
MONGODB_URI=mongodb://localhost:27017/blockefy
# For a hosted cluster instead, replace the line above with e.g.:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blockefy?retryWrites=true&w=majority

# Optional: a separate database used only by the integration tests. When unset,
# every test that needs Mongo is skipped (42 of them in the current suite).
# TEST_MONGODB_URI=mongodb://localhost:27017/blockefy_test

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:7980/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:7980/auth/github/callback

# Email (nodemailer)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@blockefy.com

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Order system
ORDER_CURRENCY=USD
PLATFORM_FEE_PERCENT=10
ORDER_TAX_PERCENT=0
ORDER_REVIEW_PERIOD_HOURS=72
PENDING_PAYMENT_TTL_MINUTES=60
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_AUTO_CONFIRM=true
PAYMENT_WEBHOOK_SECRET=blockefy-dev-webhook-secret-change-me

# ============================================================
# LiveKit Cloud (voice/video calls)
# https://cloud.livekit.io — Project Settings → API Keys
#
# LIVEKIT_URL must be the WebSocket URL (wss://...) LiveKit Cloud
# provides for your project, e.g. wss://your-project.livekit.cloud
# ============================================================
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
