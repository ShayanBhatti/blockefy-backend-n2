        );

        uint256 newMilestoneId = ++milestoneCounter;

        milestones[newMilestoneId] = Milestone({
            id: newMilestoneId,
            description: _description,
            amount: _amount,
            isFunded: false,
            isCompleted: false,
            isApproved: false,
            isClaimed: false,
            isDisputed: false,
            claimedAt: 0
        });

        projectMilestones[_projectId][newMilestoneId] = true;
        project.milestoneIds.push(newMilestoneId);

        // Adding work to a finished project re-opens it.
        if (project.status == ProjectStatus.Completed) {
            project.status = ProjectStatus.InProgress;
        }

        emit MilestoneCreated(_projectId, newMilestoneId, _amount);
        return newMilestoneId;
    }

    // =========================================================================
    //  FUNDING / ESCROW DEPOSIT (CLIENT)
    // =========================================================================

    /**
     * @notice Deposits ETH into escrow for the next unfunded milestone of a project.
     * @param _projectId The project id.
     * @dev Called by the CLIENT (payable). For a Milestones project the client must
     *      deposit the EXACT amount of the next unfunded milestone (strictly ordered).
     *      For a FixClaim project the client deposits the whole agreed amount once.
     *      Over-funding is not possible.
     */
    function depositFunds(uint256 _projectId)
        external
        payable
        whenNotPaused
        nonReentrant
        projectExists(_projectId)
        onlyClient(_projectId)
        notDisputed(_projectId)
        onlyActive(_projectId)
    {
        Project storage project = projects[_projectId];
        require(project.freelancer != address(0), "Blockefy: no freelancer assigned");
        require(msg.value > 0, "Blockefy: deposit must be > 0");

        uint256 fundedMilestoneId;

        if (project.projectType == ProjectType.FixClaim) {
            require(!project.isProjectFunded, "Blockefy: fix claim already funded");
            project.fixClaimAmount = msg.value;
            project.isProjectFunded = true;
            project.status = ProjectStatus.Funded;
        } else {
            // Strict order: the next unfunded, unclaimed milestone must be funded.
            fundedMilestoneId = _nextUnfundedMilestoneId(project);
            Milestone storage milestone = milestones[fundedMilestoneId];
            require(msg.value == milestone.amount, "Blockefy: deposit must equal milestone amount");
            milestone.isFunded = true;
            project.isProjectFunded = true;
            if (project.status == ProjectStatus.Created) {
                project.status = ProjectStatus.Funded;
            }
        }

        project.totalFunded += msg.value;
        totalEscrowed += msg.value;

        emit FundsDeposited(_projectId, msg.sender, msg.value, fundedMilestoneId);
    }

    // =========================================================================
    //  WORK SUBMISSION (FREELANCER)
    // =========================================================================

    /**
     * @notice Marks a funded milestone's work as delivered and opens the review window.
     * @param _projectId The project id.
     * @param _milestoneId The milestone id to mark complete.
     * @dev Called by the FREELANCER. Can be called again after a "changes required"
     *      revision, which re-opens the milestone for rework.
     */
    function completeMilestone(uint256 _projectId, uint256 _milestoneId)
        external
        whenNotPaused
        projectExists(_projectId)
        onlyFreelancer(_projectId)
        notDisputed(_projectId)
        onlyActive(_projectId)
    {
        Project storage project = projects[_projectId];
        _requireValidMilestone(project, _milestoneId);

        Milestone storage milestone = milestones[_milestoneId];
        require(milestone.isFunded, "Blockefy: milestone not funded");
        require(!milestone.isClaimed, "Blockefy: milestone already claimed");
        require(!milestone.isCompleted, "Blockefy: milestone already submitted");

        milestone.isCompleted = true;
        project.isSubmitted = true;
        project.status = ProjectStatus.InProgress;
        // Start the review window from this submission (auto-release safeguard).
        project.lastReviewAt = block.timestamp;

        emit MilestoneCompleted(_projectId, _milestoneId);
    }

    /**
     * @notice Submits the deliverable for a FixClaim (one-time payment) project.
     * @param _projectId The project id.
     * @dev Opens the review window so the client can approve or request changes.
     */
    function submitFixClaim(uint256 _projectId)
        external
        whenNotPaused
        projectExists(_projectId)
        onlyFreelancer(_projectId)
        notDisputed(_projectId)
        onlyActive(_projectId)
    {
        Project storage project = projects[_projectId];
        require(project.projectType == ProjectType.FixClaim, "Blockefy: not a fix claim project");
        require(project.isProjectFunded, "Blockefy: project not funded");
        require(!project.isSubmitted, "Blockefy: deliverable already submitted");

        project.isSubmitted = true;
        project.status = ProjectStatus.InProgress;
        project.lastReviewAt = block.timestamp;

        emit FixClaimSubmitted(_projectId);
    }

    // =========================================================================
    //  CLIENT REVIEW
    // =========================================================================

    /**
     * @notice Client approves a delivered milestone ("no changes required").
     * @param _projectId The project id.
     * @param _milestoneId The specific milestone being approved.
     * @dev Approval is recorded on the milestone itself, so approving one milestone
     *      never unlocks any other milestone.
     */
    function approveDeliverable(uint256 _projectId, uint256 _milestoneId)
        external
        whenNotPaused
        projectExists(_projectId)
        onlyClient(_projectId)
        notDisputed(_projectId)
        onlyActive(_projectId)
    {
        Project storage project = projects[_projectId];
        _requireValidMilestone(project, _milestoneId);

        Milestone storage milestone = milestones[_milestoneId];
        require(milestone.isCompleted, "Blockefy: no submission to approve");
        require(!milestone.isClaimed, "Blockefy: milestone already claimed");

        milestone.isApproved = true;
        project.isDeliverableAccepted = true;
        // Reset the review timer.
        project.lastReviewAt = block.timestamp;

        emit DeliverableApproved(_projectId, _milestoneId);
    }

    /**
     * @notice Client approves the deliverable of a FixClaim project.
     * @param _projectId The project id.
     * @dev FixClaim projects have no milestones, so approval is tracked at the
     *      project level for this payment model only.
     */
    function approveFixClaim(uint256 _projectId)
        external
        whenNotPaused
        projectExists(_projectId)
        onlyClient(_projectId)
        notDisputed(_projectId)
        onlyActive(_projectId)
    {
        Project storage project = projects[_projectId];
        require(project.projectType == ProjectType.FixClaim, "Blockefy: not a fix claim project");
        require(project.isSubmitted, "Blockefy: no submission to approve");
        require(project.totalFunded > 0, "Blockefy: nothing to release");

        project.isDeliverableAccepted = true;
        project.lastReviewAt = block.timestamp;

        emit DeliverableApproved(_projectId, 0);
    }

    /**
     * @notice Client requests changes on a delivered milestone.
     * @param _projectId The project id.
     * @param _milestoneId The specific milestone being sent back for rework.
     * @param _extraDays Number of days to add to the deadline for the revision.
     * @dev Re-opens the milestone so the freelancer can re-submit it, extends the
     *      project deadline, and restarts the review window.
     */
    function requestChanges(uint256 _projectId, uint256 _milestoneId, uint256 _extraDays)
        external
        whenNotPaused
        projectExists(_projectId)
        onlyClient(_projectId)
        notDisputed(_projectId)
        onlyActive(_projectId)
    {
        Project storage project = projects[_projectId];
        _requireValidMilestone(project, _milestoneId);

        require(_extraDays > 0, "Blockefy: extra days must be > 0");
        require(project.changesCount < MAX_REVISIONS, "Blockefy: revision limit reached");
        require(milestones[_milestoneId].isCompleted, "Blockefy: no submission to review");
        require(!milestones[_milestoneId].isClaimed, "Blockefy: milestone already claimed");

        // Re-open the milestone for rework (this is what makes re-submission possible).
        milestones[_milestoneId].isCompleted = false;
        milestones[_milestoneId].isApproved = false;

        project.isSubmitted = false;
        project.isDeliverableAccepted = false;
        _extendDeadline(project, _extraDays);
        project.lastReviewAt = block.timestamp;
        project.changesCount += 1;

        emit ChangesRequested(_projectId, _milestoneId, project.deadline);
    }

    /**
     * @notice Client extends the project deadline.
     * @param _projectId The project id.
     * @param _extraDays Number of days to extend.
     * @dev The extension is ADDITIVE: the deadline can only ever move later, never
     *      earlier, so an extension can never accidentally shorten a project.
     */
    function extendDeadline(uint256 _projectId, uint256 _extraDays)
        external
        projectExists(_projectId)
        onlyClient(_projectId)
        notDisputed(_projectId)
        onlyActive(_projectId)
    {
        require(_extraDays > 0, "Blockefy: extra days must be > 0");
        _extendDeadline(projects[_projectId], _extraDays);

        emit DeadlineExtended(_projectId, projects[_projectId].deadline);    }

    // =========================================================================
    //  MILESTONE CLAIMING (SEQUENTIAL)
    // =========================================================================

    /**
     * @notice Releases the payment for a milestone to the freelancer.
     * @param _projectId The project id.
     * @param _milestoneId The milestone id to claim.
     * @dev Milestones are released in STRICT SEQUENTIAL order (1 -> 2 -> 3). A
     *      milestone can only be claimed if it is funded, completed, all previous
     *      milestones are claimed, and it was approved by the client OR its review
     *      window lapsed.
     */
    function claimMilestone(uint256 _projectId, uint256 _milestoneId)
        external
        nonReentrant
        projectExists(_projectId)
        notDisputed(_projectId)
    {
        Project storage project = projects[_projectId];
        _requireValidMilestone(project, _milestoneId);
        require(msg.sender == project.client || msg.sender == project.freelancer, "Blockefy: unauthorized");

        Milestone storage milestone = milestones[_milestoneId];
        require(milestone.isFunded, "Blockefy: milestone not funded");
        require(!milestone.isClaimed, "Blockefy: milestone already claimed");
        require(milestone.isCompleted, "Blockefy: milestone not completed");

        // Enforce sequential claiming: previous milestones must all be claimed.
        _requirePreviousClaimed(project, _milestoneId);

        // Approved by client, or the review window lapsed (auto-release safeguard).
        require(milestone.isApproved || _reviewLapsed(project), "Blockefy: not approved yet");

        // Effects before interaction.
        // NOTE: `isCompleted` / `isApproved` are deliberately preserved as an
        // on-chain audit trail of what was delivered and accepted. Re-entry is
        // blocked by `isClaimed`, so keeping them cannot unlock a second payout.
        milestone.isClaimed = true;
        milestone.claimedAt = block.timestamp;

        project.totalFunded -= milestone.amount;
        totalEscrowed -= milestone.amount;

        // Reset the per-cycle review state so the NEXT milestone needs a fresh review.
        project.isSubmitted = false;
        project.isDeliverableAccepted = false;
        project.lastReviewAt = 0;

        _payFreelancer(project, milestone.amount);

        emit MilestoneClaimed(_projectId, _milestoneId, project.freelancer, milestone.amount);

        if (_isLastMilestone(project, _milestoneId)) {
            project.status = ProjectStatus.Completed;
        } else {
            project.status = ProjectStatus.InProgress;
        }
    }

    // =========================================================================
    //  FIX CLAIM (ONE-TIME PAYMENT RELEASE)
    // =========================================================================

    /**
     * @notice Releases the full one-time fix claim payment to the freelancer.
     * @param _projectId The project id.
     * @dev For FixClaim projects only. The freelancer submits via submitFixClaim, the
     *      client approves (or the review window lapses), then either party triggers
     *      this to release funds.
     */
    function fixClaim(uint256 _projectId)
        external
        nonReentrant
        projectExists(_projectId)
        notDisputed(_projectId)
        onlyActive(_projectId)
    {
        Project storage project = projects[_projectId];
        require(project.projectType == ProjectType.FixClaim, "Blockefy: not a fix claim project");
        require(msg.sender == project.client || msg.sender == project.freelancer, "Blockefy: unauthorized");
        require(project.isProjectFunded, "Blockefy: project not funded");
        require(project.totalFunded > 0, "Blockefy: nothing to release");
        require(project.isDeliverableAccepted || _reviewLapsed(project), "Blockefy: deliverable not approved");

        uint256 escrow = project.totalFunded;
        project.totalFunded = 0;
        totalEscrowed -= escrow;
        project.isSubmitted = false;
        project.isDeliverableAccepted = false;
        project.lastReviewAt = 0;

        _payFreelancer(project, escrow);

        project.status = ProjectStatus.Completed;
    }

    // =========================================================================
    //  REFUND
    // =========================================================================

    /**
     * @notice Client retrieves any escrowed funds that are not under review.
     * @param _projectId The project id.
     * @dev Only allowed once the project deadline has passed AND there is escrow that
     *      is not already approved or submitted. This protects an approved
     *      deliverable from being refunded out from under the freelancer.
     */
    function retrieveFunds(uint256 _projectId)
        external
        nonReentrant
        projectExists(_projectId)
        onlyClient(_projectId)
        notDisputed(_projectId)
    {
        Project storage project = projects[_projectId];
        require(project.status != ProjectStatus.Completed, "Blockefy: project already completed");
        require(project.status != ProjectStatus.Cancelled, "Blockefy: project already cancelled");
        require(project.deadline != 0 && block.timestamp > project.deadline, "Blockefy: deadline not passed");
        require(project.totalFunded > 0, "Blockefy: nothing to refund");

        // Never refund a milestone that is already delivered/approved but unreleased.
        uint256[] memory ids = project.milestoneIds;
        for (uint256 i = 0; i < ids.length; i++) {
            Milestone storage m = milestones[ids[i]];
            require(
                !(m.isFunded && !m.isClaimed && (m.isCompleted || m.isApproved)),
                "Blockefy: submitted milestone is under review"
            );
        }
        require(!project.isSubmitted && !project.isDeliverableAccepted, "Blockefy: deliverable under review");

        uint256 refund = project.totalFunded;
        project.totalFunded = 0;
        totalEscrowed -= refund;
        project.status = ProjectStatus.Cancelled;
        project.isSubmitted = false;
        project.isDeliverableAccepted = false;
        project.lastReviewAt = 0;

        (bool success, ) = payable(msg.sender).call{ value: refund }("");
        require(success, "Blockefy: refund failed");

        emit FundsRefunded(_projectId, msg.sender, refund);
    }

    // =========================================================================
    //  DISPUTES
    // =========================================================================

    /**
     * @notice Opens a dispute on a project (locks all payments until resolved).
     * @param _projectId The id of the disputed project.
     * @dev Callable by the CLIENT, the FREELANCER, or the ADMIN. Anyone may freeze a
     *      project that is mid-review; only the ADMIN can resolve it.
     */
    function openDispute(uint256 _projectId)
        external
        projectExists(_projectId)
        onlyParticipant(_projectId)
    {
        Project storage project = projects[_projectId];
        require(project.status != ProjectStatus.Completed, "Blockefy: project already completed");
        require(project.status != ProjectStatus.Cancelled, "Blockefy: project already cancelled");
        require(project.status != ProjectStatus.Disputed, "Blockefy: project already disputed");

        project.status = ProjectStatus.Disputed;

        uint256[] memory ids = project.milestoneIds;
        for (uint256 i = 0; i < ids.length; i++) {
            milestones[ids[i]].isDisputed = true;
        }

        emit DisputeOpened(_projectId, msg.sender);
    }

    /**
     * @notice Resolves a dispute, releasing the remaining escrow to one party.
     * @param _projectId The id of the disputed project.
     * @param _toFreelancer Whether to release the remaining escrow to the freelancer
     *        (true) or refund it to the client (false).
     * @dev Only callable by the ADMIN. Applies the platform fee on a freelancer payout.
     */
    function resolveDispute(uint256 _projectId, bool _toFreelancer)
        external
        nonReentrant
        onlyOwner
        projectExists(_projectId)
    {
        Project storage project = projects[_projectId];
        require(project.status == ProjectStatus.Disputed, "Blockefy: project is not disputed");

        uint256 escrow = project.totalFunded;
        project.totalFunded = 0;
        if (escrow > 0) {
            totalEscrowed -= escrow;
        }

        uint256[] memory ids = project.milestoneIds;
        for (uint256 i = 0; i < ids.length; i++) {
            milestones[ids[i]].isDisputed = false;
            milestones[ids[i]].isCompleted = false;
            milestones[ids[i]].isApproved = false;
        }
        project.isSubmitted = false;
        project.isDeliverableAccepted = false;
        project.lastReviewAt = 0;

        if (escrow > 0) {
            if (_toFreelancer) {
                _payFreelancer(project, escrow);
            } else {
                (bool ok, ) = payable(project.client).call{ value: escrow }("");
                require(ok, "Blockefy: refund failed");
            }
        }

        project.status = ProjectStatus.Completed;
        emit DisputeResolved(_projectId, _toFreelancer);
    }

    // =========================================================================
    //  VIEW / QUERY FUNCTIONS
    // =========================================================================

    /// @notice Returns all milestone ids belonging to a project.
    function getProjectMilestones(uint256 _projectId) external view projectExists(_projectId) returns (uint256[] memory) {
        return projects[_projectId].milestoneIds;
    }

    /// @notice Returns the full list of milestones (as structs) for a project.
    function getMilestonesDetails(uint256 _projectId)
        external
        view
        projectExists(_projectId)
        returns (Milestone[] memory milestonesOut)
    {
        uint256[] memory ids = projects[_projectId].milestoneIds;
        milestonesOut = new Milestone[](ids.length);
        for (uint256 i = 0; i < ids.length; i++) {
            milestonesOut[i] = milestones[ids[i]];
        }
    }

    /// @notice Returns the escrow balance available in the contract for a project.
    function getProjectEscrow(uint256 _projectId) external view projectExists(_projectId) returns (uint256) {
        return projects[_projectId].totalFunded;
    }

    /**
     * @notice Checks whether the review window for a project has lapsed.
     * @param _projectId The project id.
     * @dev Only meaningful while work is submitted and not yet approved.
     */
    function isReviewLapsed(uint256 _projectId) external view projectExists(_projectId) returns (bool) {
        return _reviewLapsed(projects[_projectId]);
    }

    // =========================================================================
    //  INTERNAL / PRIVATE HELPER FUNCTIONS
    // =========================================================================

    /**
     * @dev Validates that a milestone belongs to the given project and is not disputed.
     */
    function _requireValidMilestone(Project storage _project, uint256 _milestoneId) private view {
        require(projectMilestones[_project.id][_milestoneId], "Blockefy: milestone not in project");
        require(!milestones[_milestoneId].isDisputed, "Blockefy: milestone disputed");
    }

    /**
     * @dev Returns the id of the next milestone that still needs to be funded
     *      (strictly in order). Reverts when every milestone is already funded/claimed.
     */
    function _nextUnfundedMilestoneId(Project storage _project) private view returns (uint256) {
        uint256[] memory ids = _project.milestoneIds;
        for (uint256 i = 0; i < ids.length; i++) {
            Milestone storage m = milestones[ids[i]];
            if (!m.isFunded && !m.isClaimed) {
                return ids[i];
            }
        }
        revert("Blockefy: no milestone awaiting funding");
    }

    /**
     * @dev Enforces sequential milestone claiming: all milestones before this one
     *      must have been claimed already.
     */
    function _requirePreviousClaimed(Project storage _project, uint256 _milestoneId) private view {
        uint256[] memory ids = _project.milestoneIds;
        for (uint256 i = 0; i < ids.length; i++) {
            if (ids[i] == _milestoneId) {
                return;
            }
            require(milestones[ids[i]].isClaimed, "Blockefy: previous milestone not claimed");
        }
        revert("Blockefy: milestone not found");
    }

    /**
     * @dev Checks whether the given milestone is the last one in the project.
     */
    function _isLastMilestone(Project storage _project, uint256 _milestoneId) private view returns (bool) {
        uint256[] memory ids = _project.milestoneIds;
        return ids.length > 0 && ids[ids.length - 1] == _milestoneId;
    }

    /**
     * @dev Extends a project's deadline by `_extraDays`, never shortening it.
     *      The base is the later of the current deadline and now, so an extension
     *      requested after the deadline has already lapsed still yields a usable
     *      future deadline.
     */
    function _extendDeadline(Project storage _project, uint256 _extraDays) private {
        require(_extraDays > 0, "Blockefy: extra days must be > 0");
        require(_extraDays <= MAX_DEADLINE_EXTENSION, "Blockefy: extension too long");
        uint256 base = _project.deadline > block.timestamp ? _project.deadline : block.timestamp;
        _project.deadline = base + (_extraDays * 1 days);
    }

    /**
     * @dev Checks whether the client's review window has lapsed after a submission.
     *      Because milestone claiming is strictly sequential, only one milestone is
     *      ever in review at a time, so the project-level timer is correct.
     */
    function _reviewLapsed(Project storage _project) private view returns (bool) {
        if (!_project.isSubmitted) {
            return false;
        }
        return _project.lastReviewAt != 0 &&
               (block.timestamp > _project.lastReviewAt + _project.reviewWindow);
    }

    /**
     * @dev Pays the freelancer, subtracting the platform fee (currently 0%) if any.
     */
    function _payFreelancer(Project storage _project, uint256 _amount) private {
        uint256 fee = (_amount * platformFeeBps) / 10000;
        uint256 net = _amount - fee;

        (bool success, ) = payable(_project.freelancer).call{ value: net }("");
        require(success, "Blockefy: payout failed");

        if (fee > 0) {
            (bool ok, ) = payable(treasury).call{ value: fee }("");
            require(ok, "Blockefy: treasury transfer failed");
        }
    }

    /**
     * @notice Allows the contract to receive ETH directly (e.g. accidental transfers).
     * @dev Such transfers are untracked surplus and can be recovered by the owner via
     *      `sweepSurplus`; they never become part of any project's escrow.
     */
    receive() external payable {}
}
